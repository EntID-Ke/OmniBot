<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="omni_account_tokens.xml" />
        <exclude domain="sharedpref" path="omni_model_provider_secrets.xml" />
        <!-- OAuth files remain on the device; the official Codex runtime owns them. -->
        <exclude domain="root" path="local/alpine/root/.codex-chatgpt/auth.json" />
        <exclude domain="root" path="local/ubuntu/root/.codex-chatgpt/auth.json" />
        <!-- TODO: Use <include> and <exclude> to control what is backed up.
        <include .../>
        <exclude .../>
        -->
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="omni_account_tokens.xml" />
        <exclude domain="sharedpref" path="omni_model_provider_secrets.xml" />
        <!-- OAuth files remain on the device; the official Codex runtime owns them. -->
        <exclude domain="root" path="local/alpine/root/.codex-chatgpt/auth.json" />
        <exclude domain="root" path="local/ubuntu/root/.codex-chatgpt/auth.json" />
    </device-transfer>
</data-extraction-rules>
